# Django
SECRET_KEY=change-this-to-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=leaderBoard
DB_USER=postgres
DB_PASSWORD=postgres
